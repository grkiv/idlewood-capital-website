# Database Configuration
POSTGRES_URL=postgres://...
POSTGRES_PRISMA_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...

# Authentication
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_REFRESH_SECRET=your-refresh-token-secret-key-here

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token-here
BLOB_BASE_URL=https://your-blob-url.com

# File Storage Security Configuration
FILE_ENCRYPTION_ENABLED=true
FILE_ENCRYPTION_KEY=your-32-character-encryption-key-here
VIRUS_SCANNING_ENABLED=true

# File Upload Limits
MAX_FILE_SIZE=104857600
MAX_FILES_PER_USER=1000
DEFAULT_QUOTA_BYTES=10737418240

# Signed URL Configuration
DEFAULT_SIGNED_URL_EXPIRY=3600
MAX_SIGNED_URL_EXPIRY=604800

# File Processing
FILE_COMPRESSION_ENABLED=true
COMPRESSION_THRESHOLD=1048576
COMPRESSION_QUALITY=85

# Thumbnail Generation
THUMBNAIL_ENABLED=true
THUMBNAIL_MAX_WIDTH=300
THUMBNAIL_MAX_HEIGHT=300
THUMBNAIL_QUALITY=80

# Email Configuration (for notifications)
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=noreply@your-domain.com
SENDER_NAME="Idlewood Capital"

# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# Development
NODE_ENV=development