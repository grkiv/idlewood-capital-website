# Vercel Postgres Database Configuration
# Copy this file to .env.local and update with your actual values

# Required: Your Vercel Postgres connection string
# Get this from your Vercel dashboard > Storage > Postgres
POSTGRES_URL="postgres://username:password@host:port/database?sslmode=require"

# Optional: Admin user credentials for database seeding
# These are used when running npm run db:seed
ADMIN_EMAIL="admin@idlewood-capital.com"
ADMIN_PASSWORD="change-this-secure-password"

# Next.js specific environment variables
# Add any additional environment variables your app needs below

# Example: Email service configuration (if using)
# EMAIL_SERVER="smtp://username:password@smtp.gmail.com:587"
# EMAIL_FROM="noreply@idlewood-capital.com"

# Example: File upload configuration
# UPLOAD_MAX_SIZE="10485760"  # 10MB in bytes
# UPLOAD_ALLOWED_TYPES="application/pdf,image/jpeg,image/png,application/msword"